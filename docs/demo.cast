[0.014, "o", "\u001b[2m# flashblocks: decode Base's public Flashblocks stream (brotli + RLP, 200 ms slices) in real time\u001b[0m\r\n"]
[1.508, "o", "\u001b[2m# one line per Chainlink price update, ~0.5 ms per slice, confirmed from the slice's logs_bloom\u001b[0m\r\n"]
[2.015, "o", "\u001b[2m# install: cargo install flashblocks\u001b[0m\r\n"]
[1.512, "o", "\u001b[1;36m$ flashblocks-tail --feed $BTC_USD --feed $CBETH_USD --feed $AERO_USD   # Chainlink aggregators on Base\u001b[0m\r\n"]
